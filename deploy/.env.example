# Copy to deploy/.env (git-ignored) and fill in. Used by deploy/configure.sh.

# Root domain for the classroom. Four DNS A records must point at the server:
#   <HUB_DOMAIN>, assets.<HUB_DOMAIN>, stream.<HUB_DOMAIN>, cors.<HUB_DOMAIN>
HUB_DOMAIN=classroom.example.edu.ph

# Admin account (gets the Hubs admin panel). Use a school/project address, not a personal one.
ADM_EMAIL=classroom-admin@example.edu.ph

# SMTP for teacher sign-in emails (magic links). Learners never sign in.
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=changeMe
SMTP_PASS=changeMe

# Our custom Hubs client image (built by .github/workflows/classroom-build.yml).
HUBS_IMAGE=ghcr.io/ben010618/classroom-hubs:latest

# Pinned upstream deployment tooling. Bump deliberately, after testing on staging.
HUBS_CLOUD_REF=316e49e255f71ef79b1b22bba75ceaa69ebc6917

# Storage: K3s ships the "local-path" storage class (single node). Size of each persistent volume.
PERSISTENT_VOLUME_STORAGE_CLASS=local-path
PERSISTENT_VOLUME_SIZE=20Gi
